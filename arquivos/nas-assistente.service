[Unit]
Description=NAS: pagina de configuracao e painel (porta 8000)
After=network-online.target nas-preparar.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
ExecStart=/usr/bin/python3 /usr/local/lib/nas/nas-assistente.py
Restart=always
RestartSec=5
# Pagina fora do ar: o LED volta ao batimento normal do Linux
ExecStopPost=-/usr/local/sbin/nas-led ligando

[Install]
WantedBy=multi-user.target
